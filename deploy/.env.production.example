# Copy to .env.production and set actual production values. Never commit this file after filling secrets.
VITE_API_URL=https://api.your-domain.com
App__CorsOrigins=https://admin.your-domain.com
App__FrontendUrl=https://admin.your-domain.com
AuthServer__Authority=https://api.your-domain.com
AuthServer__ClientId=ldt-spa
ConnectionStrings__Default=Server=sql-server;Database=LdtAdmin;User Id=ldt_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
# Docker path; for direct Windows execution use an absolute Windows certificate path.
AuthServer__SigningCertificatePath=/certificates/identity-signing.pfx
AuthServer__SigningCertificatePassword=CHANGE_ME
Seed__AdminEmail=admin@your-domain.com
Seed__AdminPassword=CHANGE_ME_TO_A_STRONG_PASSWORD
# Trusted TLS proxy's address as observed by the backend. Do not configure all networks as trusted.
ReverseProxy__KnownProxies__0=127.0.0.1
